<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Section: Side-by-Side Responsive Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Side: Main Budget Summary -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_month_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOADING..."
                android:textColor="#2EC4B6"
                android:textSize="11sp"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUDGET SPEND"
                android:textColor="#8F939D"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <!-- Main Stats -->
            <TextView
                android:id="@+id/widget_spent_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/widget_total_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="of ₹0"
                android:textColor="#8F939D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="0dp" />

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:progressDrawable="@drawable/widget_progress_drawable"
                android:max="100"
                android:progress="0" />
            <ProgressBar
                android:id="@+id/widget_progress_bar_over"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:progressDrawable="@drawable/widget_progress_over_drawable"
                android:max="100"
                android:progress="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_remaining_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0 left"
                android:textColor="#2EC4B6"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Right Side: Dynamic Buckets List -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:gravity="top">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUCKETS"
                android:textColor="#8F939D"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/buckets_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Section: Full Width Action Button -->
    <LinearLayout
        android:id="@+id/widget_add_button"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:orientation="horizontal">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+  LOG TRANSACTION"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Signature Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FinStack 360 by Amarjith"
        android:textColor="#66FFFFFF"
        android:textSize="7sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

</LinearLayout>